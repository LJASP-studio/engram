{
  "always": [
    "Read(./**/node_modules/**)",
    "Read(./**/dist/**)",
    "Read(./**/build/**)",
    "Read(./**/.next/**)",
    "Read(./**/coverage/**)",
    "Read(./**/.venv/**)",
    "Read(./**/__pycache__/**)",
    "Read(./**/*.min.js)",
    "Read(./**/*.map)",
    "Read(./**/package-lock.json)",
    "Read(./**/pnpm-lock.yaml)",
    "Read(./**/yarn.lock)",
    "Read(./**/.obsidian/workspace*.json)"
  ],
  "ifFound": {
    "*.csproj, *.sln": ["Read(./**/bin/**)", "Read(./**/obj/**)"],
    "Cargo.toml, pom.xml": ["Read(./**/target/**)"],
    "*.xcodeproj, Package.swift": ["Read(./**/DerivedData/**)", "Read(./**/.build/**)", "Read(./**/Pods/**)"],
    "build.gradle, build.gradle.kts": ["Read(./**/.gradle/**)"],
    "go.mod, composer.json": ["Read(./**/vendor/**)"]
  }
}
