{
  "description": "Live graph: tells the engram-live Obsidian plugin which vault notes Claude reads or writes, and when Claude finishes. Does nothing unless that plugin is enabled in a vault near the project.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/live.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/live.sh\"",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
